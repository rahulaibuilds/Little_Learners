# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/learnnest?schema=public"

# Authentication
AUTH_SECRET="your-auth-secret-min-32-chars-change-in-production"
SESSION_SECRET="your-session-secret-min-32-chars-change-in-production"
JWT_SECRET="your-jwt-secret-min-32-chars-change-in-production"
JWT_EXPIRY="7d"

# OTP Service
OTP_PROVIDER="mock" # mock | twilio | msg91 | aws-sns
OTP_API_KEY=""
OTP_API_SECRET=""
OTP_SENDER_ID="LRNNST"
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_WINDOW_MS=60000
OTP_RATE_LIMIT_MAX_REQUESTS=3

# Email Service
EMAIL_PROVIDER="mock" # mock | sendgrid | mailgun | ses | nodemailer
EMAIL_API_KEY=""
EMAIL_FROM="noreply@learnnest.in"
EMAIL_FROM_NAME="LearnNest India"
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# Object Storage
STORAGE_PROVIDER="local" # local | s3 | gcs | azure
STORAGE_URL=""
STORAGE_BUCKET="learnnest-assets"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="us-east-1"
STORAGE_CDN_URL=""

# AI Services
AI_PROVIDER="mock" # mock | openai | anthropic | google
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
REDIS_DB=0

# Analytics
ANALYTICS_PROVIDER="mock" # mock | posthog | mixpanel | amplitude
ANALYTICS_API_KEY=""
ANALYTICS_HOST=""

# Application
NEXT_PUBLIC_APP_NAME="LearnNest India"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NODE_ENV="development"
PORT=3000

# Feature Flags
FEATURE_AI_RECOMMENDATIONS="true"
FEATURE_AI_STORIES="false"
FEATURE_VOICE="false"
FEATURE_OFFLINE="false"
FEATURE_ANALYTICS="true"
FEATURE_REALTIME_PROGRESS="true"

# Security
BCRYPT_ROUNDS=12
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CSRF_SECRET="your-csrf-secret-change-in-production"

# Parent Verification
PARENT_VERIFICATION_PROVIDER="mock" # mock | digilocker | aadhaar | manual
PARENT_VERIFICATION_API_KEY=""

# Child Safety
CHILD_DATA_RETENTION_DAYS=365
CHILD_AVATAR_STORAGE_DAYS=30
MAX_CHILDREN_PER_PARENT=5